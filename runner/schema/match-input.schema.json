{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ezomic/nutmeg/runner/schema/match-input.schema.json",
  "title": "Nutmeg match input, schema version 1",
  "type": "object",
  "required": ["schemaVersion", "engineVersion", "seed", "home", "away"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "engineVersion": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
    "matchId": { "type": "string", "maxLength": 128 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "context": {
      "type": "object",
      "properties": {
        "homeAdvantage": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "weather": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["clear"] }
          }
        }
      }
    },
    "home": { "$ref": "#/$defs/team" },
    "away": { "$ref": "#/$defs/team" }
  },
  "$defs": {
    "team": {
      "type": "object",
      "required": ["name", "formation", "mentality", "lineup"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "formation": { "type": "string", "enum": ["442", "433", "352", "4231", "532", "343"] },
        "mentality": { "type": "string", "enum": ["attacking", "balanced", "defensive"] },
        "lineup": { "type": "array", "minItems": 11, "maxItems": 11, "items": { "$ref": "#/$defs/player" } },
        "bench": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/player" } }
      }
    },
    "player": {
      "type": "object",
      "required": ["id", "name", "position", "attributes"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "position": { "type": "string", "enum": ["GK", "DF", "MF", "FW"] },
        "slot": { "type": "integer", "minimum": 0, "maximum": 10 },
        "shirt": { "type": "integer", "minimum": 1, "maximum": 99 },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    },
    "attributes": {
      "type": "object",
      "required": ["vision", "passing", "dribbling", "finishing", "tackling", "pace"],
      "properties": {
        "vision": { "$ref": "#/$defs/attribute" },
        "passing": { "$ref": "#/$defs/attribute" },
        "dribbling": { "$ref": "#/$defs/attribute" },
        "finishing": { "$ref": "#/$defs/attribute" },
        "tackling": { "$ref": "#/$defs/attribute" },
        "pace": { "$ref": "#/$defs/attribute" }
      },
      "additionalProperties": { "$ref": "#/$defs/attribute" }
    },
    "attribute": { "type": "integer", "minimum": 1, "maximum": 100 }
  }
}
